\definecolor{primary}{RGB}{45, 62, 80}
\definecolor{accent}{RGB}{52, 152, 219}
\definecolor{lightgray}{RGB}{150, 150, 150}

\titleformat{\section}
  {\Large\bfseries\color{primary}\uppercase}
  {}{0em}
  {}[\titlerule]
\titlespacing{\section}{0pt}{12pt}{8pt}

\titleformat{\subsection}
  {\large\bfseries\color{accent}}
  {}{0em}
  {}
\titlespacing{\subsection}{0pt}{5pt}{3pt}


% \jobentry{tytuł}{firma}{miejsce}{okres}{opis}
\newcommand{\jobentry}[5]{
    \noindent
    \textbf{\large #1} \hfill \textcolor{primary}{\textbf{#2}} \\
    {\small \faMapMarker* \ #3 \hfill \faCalendar* \ #4}
    \par
    \vspace{3pt}
    \parbox{\linewidth}{
        \small #5
    }
    \vspace{8pt}
}

% \eduentry{logo}{tytuł}{szkoła}{miejsce}{okres}{opis}
\newcommand{\eduentry}[6]{
    \noindent
    \begin{minipage}[t]{0.12\linewidth}
        \vspace{0pt}
        \centering
        \includegraphics[width=\linewidth, keepaspectratio]{#1}
    \end{minipage}
    \hfill
    \begin{minipage}[t]{0.86\linewidth}
        \vspace{0pt}
        \textbf{\large #2} \hfill \textcolor{primary}{\textbf{#3}} \\
        {\small \faMapMarker* \ #4 \hfill \faCalendar* \ #5}
        \par
        \vspace{6pt}
        \begingroup
            \small \itshape
            \setlength{\baselineskip}{11pt}
            #6
            \par
        \endgroup
    \end{minipage}
    \vspace{8pt}
}

% \flagitem{png}{opis}
\newcommand{\flagitem}[2]{
    \item[
        \raisebox{-0.2\height}{\includegraphics[height=9pt, width=15pt]{#1}}
    ] #2
}

% \imgitem{png}{opis}
\newcommand{\imgitem}[2]{
    \item[
        \raisebox{-0.2\height}{\includegraphics[height=12pt]{#1}}
    ] #2
}

% \projentry{tytuł}{opis}
\newcommand{\projentry}[2]{
    \noindent
    \textbf{\large #1}
    \par
    \vspace{2pt}
    \begingroup
        \small
        \setlength{\baselineskip}{11pt}
        #2
        \par
    \endgroup
    \vspace{10pt}
}
