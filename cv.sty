\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}

% ---------- Język: \usepackage[english]{cv} albo \usepackage[polish]{cv} ----------
\newcommand{\cv@lang}{polish}
\DeclareOption{english}{\renewcommand{\cv@lang}{english}}
\DeclareOption{polish}{\renewcommand{\cv@lang}{polish}}
\ProcessOptions\relax

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[\cv@lang]{babel}
\usepackage[default]{raleway}
\usepackage{geometry}
\usepackage{xcolor}
\usepackage{graphicx}
\usepackage{fontawesome5}
\usepackage{tabularx}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{wrapfig}
\usepackage{multirow}
\usepackage{hyperref}
\usepackage{comment}

\geometry{left=1.5cm, right=1.5cm, top=1.5cm, bottom=1.5cm}
\pagestyle{empty}
\setlength{\parindent}{0pt}

\definecolor{primary}{RGB}{45, 62, 80}
\definecolor{accent}{RGB}{52, 152, 219}
\definecolor{lightgray}{RGB}{150, 150, 150}

\titleformat{\section}
  {\Large\bfseries\color{primary}}
  {}{0em}
  {\MakeUppercase}[\titlerule]
\titlespacing{\section}{0pt}{0pt}{8pt}

% jednolity odstęp przed sekcją; \addvspace łączy się z odstępem po poprzednim wpisie.
% \@minipagefalse: na górze minipage \addvspace nic nie robi (i dobrze), ale flaga
% nie jest kasowana po pierwszej sekcji, więc kasujemy ją ręcznie
\newlength{\sectiongap}
\setlength{\sectiongap}{14pt}
\let\cvoldsection\section
\renewcommand{\section}{\par\addvspace{\sectiongap}\@minipagefalse\cvoldsection}

\titleformat{\subsection}
  {\large\bfseries\color{accent}}
  {}{0em}
  {}
\titlespacing{\subsection}{0pt}{5pt}{3pt}


% słowo między stanowiskiem a firmą; po polsku puste, bo "w" wymagałoby odmiany nazwy firmy
% (można nadpisać w .tex przez \renewcommand{\jobat}{...})
\newcommand{\jobat}{}
\def\cv@tmp{english}\ifx\cv@lang\cv@tmp \renewcommand{\jobat}{at}\fi

% \jobentry{tytuł}{firma}{miejsce}{okres}{opis}
\newcommand{\jobentry}[5]{
    \noindent
    % jeśli firma się nie mieści obok tytułu, przechodzi w całości do nowej linii (do prawej)
    {\mbox{\textbf{\large #1}}\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfil
        \mbox{\if\relax\detokenize\expandafter{\jobat}\relax\else\textcolor{lightgray}{\jobat}\ \fi\textcolor{primary}{\textbf{#2}}}\parfillskip=0pt\par}
    {\small \faMapMarker* \ #3 \hfill \faCalendar* \ #4}
    \par
    \vspace{3pt}
    \parbox{\linewidth}{
        \small #5
    }
    \par\addvspace{8pt}
}

% \eduentry{logo}{tytuł}{szkoła}{miejsce}{okres}{opis}
% logo skalowane do wysokości bloku tekstu
\newsavebox{\edutextbox}
\newlength{\eduboxheight}
\newcommand{\eduentry}[6]{
    \noindent
    \sbox{\edutextbox}{%
    \begin{minipage}[t]{0.79\linewidth}
        \vspace{0pt}
        {\mbox{\textbf{\large #2}}\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfil
            \mbox{\textcolor{primary}{\textbf{#3}}}\parfillskip=0pt\par}
        {\small \faMapMarker* \ #4 \hfill \faCalendar* \ #5}
        \par
        \vspace{6pt}
        \begingroup
            \small \itshape
            \setlength{\baselineskip}{11pt}
            #6
            \par
        \endgroup
    \end{minipage}}%
    \setlength{\eduboxheight}{\dimexpr\ht\edutextbox+\dp\edutextbox\relax}%
    \ifdim\eduboxheight>0.2\linewidth \setlength{\eduboxheight}{0.2\linewidth}\fi
    \begin{minipage}[t]{\eduboxheight}
        \vspace{0pt}
        \includegraphics[height=\eduboxheight, keepaspectratio]{#1}
    \end{minipage}%
    \hfill
    \usebox{\edutextbox}
    \par
    \addvspace{8pt}
}

% \flagitem{png}{opis}
\newcommand{\flagitem}[2]{
    \item[
        \raisebox{-0.2\height}{\includegraphics[height=9pt, width=15pt]{#1}}
    ] #2
}

% \imgitem{png}{opis}
% jeśli pliku nie ma, rysuje szary kwadrat jako placeholder
\newcommand{\imgitem}[2]{
    \item[
        \IfFileExists{#1}
            {\raisebox{-0.2\height}{\includegraphics[height=12pt]{#1}}}
            {\raisebox{-0.2\height}{\textcolor{lightgray!60}{\rule{12pt}{12pt}}}}
    ] #2
}

% \projentry{tytuł}{opis}
\newcommand{\projentry}[2]{
    \noindent
    \textbf{\large #1}
    \par
    \vspace{2pt}
    \begingroup
        \small
        \setlength{\baselineskip}{11pt}
        #2
        \par
    \endgroup
    \par\addvspace{8pt}
}

% \skillgroup{kategoria}{\imgitem...}
\newcommand{\skillgroup}[2]{
    \noindent
    {\small\bfseries\color{accent} #1}
    \begin{itemize}[leftmargin=2.5em, labelsep=0.5em, itemsep=1pt, topsep=2pt]
        \small\raggedright
        #2
    \end{itemize}
    \par\addvspace{4pt}
}

% \interestgroup{kategoria}{\item ...}
\newcommand{\interestgroup}[2]{
    \noindent
    {\small\bfseries\color{accent} #1}
    \begin{itemize}[itemsep=1pt, topsep=2pt, leftmargin=1.5em]
        \small
        #2
    \end{itemize}
    \par\addvspace{4pt}
}

% lista z ikonami (\flagitem / \imgitem)
\newenvironment{iconlist}
    {\begin{itemize}[leftmargin=2.5em, labelsep=0.5em, itemsep=2pt]}
    {\end{itemize}}

% ---------- Układ strony ----------

% \cvheader{imię}{nazwisko}{email}{telefon}{miejsce}
\newcommand{\cvheader}[5]{
    \noindent
    \begin{minipage}[c]{0.55\textwidth}
        {\fontsize{30}{36}\selectfont \textbf{\color{primary} #1 \color{accent} #2}}
    \end{minipage}
    \hfill
    \begin{minipage}[c]{0.4\textwidth}
        \raggedleft
        \href{mailto:#3}{#3} \ \faEnvelope \\
        #4 \ \faPhone \\
        #5 \ \faMapMarker*
    \end{minipage}
    \par
    \vspace{6pt}
    {\color{primary}\rule{\textwidth}{1.2pt}}
    \vspace{2pt}
    \par
}

% lewa kolumna; musi być bezpośrednio przed cvmain
\newenvironment{cvsidebar}
    {\noindent\begin{minipage}[t]{0.30\textwidth}\vspace{0pt}}
    {\end{minipage}\hfill{\color{lightgray!50}\vrule width 0.5pt}\hfill}

% prawa (główna) kolumna
\newenvironment{cvmain}
    {\begin{minipage}[t]{0.65\textwidth}\vspace{0pt}}
    {\end{minipage}}
